# ---------------------------------------------------------------------------
# Frozen settings for the TSO500 off-target tumour-fraction pipeline.
# Every value here is the one used for the published analysis. Do not change
# FLANK, BIN_SIZE, MAPQ or NORMAL_GRID without rebuilding the panel of normals.
# ---------------------------------------------------------------------------

# --- set this to wherever this bundle was unpacked -------------------------
export PIPE_ROOT="${PIPE_ROOT:?set PIPE_ROOT to the install/ directory of this bundle}"

# --- bundle version -------------------------------------------------------
# 2.1 (2026-09-11): initialisation grid returned to ichorCNA's distributed default.
# 2.0 (2026-09-10): ichorCNA package defaults + 17-normal v1 PoN.
# Tumour fractions from 1.x are not comparable. See ../CHANGELOG.md.
export PIPE_VERSION="$(cat "$PIPE_ROOT/VERSION" 2>/dev/null || echo 2.0)"

# --- frozen analysis settings ---------------------------------------------
export FLANK=50                     # bp added to each side of every target interval
export BIN_SIZE=1000000             # readCounter window
export MAPQ=20                      # readCounter --quality
export GENOME_BUILD=hg19
export GENOME_STYLE=NCBI            # ichorCNA --genomeStyle for the panel arm
export CHROMS="chr1,chr2,chr3,chr4,chr5,chr6,chr7,chr8,chr9,chr10,chr11,chr12,chr13,chr14,chr15,chr16,chr17,chr18,chr19,chr20,chr21,chr22,chrX,chrY"
export NORMAL_GRID="c(0.5,0.6,0.7,0.8,0.9,0.95)"        # ichorCNA's distributed default

# --- bundled reference files ----------------------------------------------
export PROBE_REF="$PIPE_ROOT/reference/target_sequences_flank50.fasta"   # bwa-indexed; build with scripts/00_build_probe_reference.sh
export GC_WIG="$PIPE_ROOT/reference/gc_hg19_1000kb.wig"
export MAP_WIG="$PIPE_ROOT/reference/map_hg19_1000kb.wig"
export CENTROMERE="$PIPE_ROOT/reference/centromere_hg19.txt"
# --- panel of normals, per TSO500 assay version -----------------------------
#   v1 -> pon_v1_17 (17 normals; one member removed 2026-09-10 - it returns
#                    TF=1.0 / ploidy 0.92 under every configuration tested.
#                    The superseded 18-member panel is not distributed.)
#   v2 -> PoN_V2 (10 healthy donors sequenced on TSO500 v2)
# Both MUST be flank-matched to $FLANK. Selection happens in scripts/lib_pon.sh:
# explicit PANEL_VERSION (or --v1/--v2) wins, else the input path is inspected for
# a v1/v2 component, else the default below is used.
export PANEL_VERSION="${PANEL_VERSION:-}"          # v1 | v2 | (empty = decide per input)
export PANEL_VERSION_DEFAULT=v2                    # used when nothing identifies the assay
export PON_V1="$PIPE_ROOT/pon/pon_v1_17_non_amplified_flank${FLANK}.rds_median.rds"
export PON_V2="$PIPE_ROOT/pon/pon_v2_non_amplified_flank${FLANK}.rds_median.rds"
# $PON is resolved by scripts/lib_pon.sh; set it explicitly here or in the
# environment only if you want to override the version-based choice entirely.

# --- bundled tools --------------------------------------------------------
export RLIB="$PIPE_ROOT/Rlib"
export RUNNER="$PIPE_ROOT/scripts/runIchorCNA_v060.R"
# readCounter comes from HMMcopy utils (bioconda: hmmcopy); a copy in scripts/ wins.
export READCOUNTER="${READCOUNTER:-$( [ -x "$PIPE_ROOT/scripts/readCounter" ] && echo "$PIPE_ROOT/scripts/readCounter" || command -v readCounter )}"

# --- external tools that must already be on PATH --------------------------
#   bwa      >= 0.7.17
#   samtools >= 1.13
#   Rscript  >= 4.4  with optparse, HMMcopy, GenomicRanges
